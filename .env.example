# MeminiOS environment reference
#
# Copy this file to .env for local development and fill only the sections you use:
#   cp .env.example .env
#   set -a; source .env; set +a
#
# Explicitly exporting is currently necessary because workspace package scripts execute from
# their package directories and do not all discover the repository-root .env automatically.
#
# Never commit real credentials.
#   CURRENT  = referenced by executable code, a script, or a deployment workflow today.
#   BINDING  = declared by a runtime/config contract but not consumed by a live data path yet.
#   RESERVED = needed by the specification's production integration, but not implemented yet.
#
# Cloudflare resource bindings still belong in wrangler.jsonc, and non-secret tenant policy
# belongs in Postgres rather than global environment configuration.

# -----------------------------------------------------------------------------
# Local data plane (CURRENT + BINDING)
# -----------------------------------------------------------------------------

# Used by database migration and seed commands.
DATABASE_URL=postgres://meminios:meminios@127.0.0.1:55432/meminios

# BINDING: used by the Cloudflare API environment contract. In production this should resolve
# through Hyperdrive or another configured Postgres endpoint rather than exposing a public connection.
DATABASE_ENDPOINT=postgres://meminios:meminios@127.0.0.1:55432/meminios

# BINDING: config-driven data-plane endpoints. Local values are descriptive until the associated
# repositories/transports are wired. Production Workers use named R2/Queue bindings.
OBJECT_STORE_ENDPOINT=r2://meminios-local
QUEUE_ENDPOINT=cloudflare-queues://local
KMS_ENDPOINT=local://meminios-development-key
# RESERVED: provider-backed credential storage required by FR-8.2.
SECRETS_MANAGER_ENDPOINT=local://meminios-development-secrets

# -----------------------------------------------------------------------------
# Browser and API (CURRENT)
# -----------------------------------------------------------------------------

# Browser-visible API base URL. Leave empty for same-origin requests through the Vite proxy.
VITE_API_URL=http://127.0.0.1:8787

# Exact browser origin allowed by API CORS; no trailing slash.
APP_ORIGIN=http://127.0.0.1:5173

# Local development only. This must be false in every deployed environment.
DEV_AUTH_ENABLED=true

# Public URLs used for redirects and generated links (RESERVED).
PUBLIC_APP_URL=http://127.0.0.1:5173
PUBLIC_API_URL=http://127.0.0.1:8787
PUBLIC_LANDING_URL=http://127.0.0.1:3000
NEXT_PUBLIC_MEMINIOS_APP_URL=http://127.0.0.1:5173
NEXT_PUBLIC_MEMINIOS_API_URL=http://127.0.0.1:8787

# -----------------------------------------------------------------------------
# WorkOS AuthKit, SSO, and SCIM (RESERVED)
# -----------------------------------------------------------------------------

WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_AUTHKIT_DOMAIN=
WORKOS_REDIRECT_URI=http://127.0.0.1:8787/auth/callback
WORKOS_POST_LOGOUT_REDIRECT_URI=http://127.0.0.1:5173
WORKOS_WEBHOOK_SECRET=

# Generate with: openssl rand -base64 32
# Used to seal the HttpOnly application session and short-lived OAuth state/PKCE cookies.
WORKOS_COOKIE_PASSWORD=

# PKCE is intentionally not configurable: the implementation should always use S256.
# Do not add the WorkOS API key, client secret, refresh tokens, or session tokens to VITE_* vars.

# -----------------------------------------------------------------------------
# MCP bridge (CURRENT)
# -----------------------------------------------------------------------------

MEMINIOS_MCP_URL=http://127.0.0.1:8787/mcp

# Use a scoped agent/API credential in production. Blank uses local dev auth.
MEMINIOS_MCP_TOKEN=

# -----------------------------------------------------------------------------
# Connector fabric and native OAuth applications (RESERVED)
# -----------------------------------------------------------------------------

COMPOSIO_API_KEY=

# Slack OAuth application credentials. Per-tenant bot/user tokens belong in the configured
# secrets manager and must not be stored as process environment variables.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_REDIRECT_URI=http://127.0.0.1:8787/auth/connectors/slack/callback

# Google Workspace OAuth application credentials. Per-tenant refresh tokens belong in the
# configured secrets manager.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8787/auth/connectors/google/callback
GOOGLE_WEBHOOK_VERIFICATION_TOKEN=

# Microsoft 365 OAuth application credentials for Outlook, Teams, and SharePoint.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://127.0.0.1:8787/auth/connectors/microsoft/callback
MICROSOFT_WEBHOOK_CLIENT_STATE_SECRET=

# GitHub App credentials.
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_PRIVATE_KEY_BASE64=
GITHUB_WEBHOOK_SECRET=

# Notion OAuth application credentials.
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://127.0.0.1:8787/auth/connectors/notion/callback

# A single Atlassian OAuth application can serve Jira and Confluence.
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
ATLASSIAN_REDIRECT_URI=http://127.0.0.1:8787/auth/connectors/atlassian/callback
ATLASSIAN_WEBHOOK_SECRET=

LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_REDIRECT_URI=http://127.0.0.1:8787/auth/connectors/linear/callback
LINEAR_WEBHOOK_SECRET=

ZENDESK_CLIENT_ID=
ZENDESK_CLIENT_SECRET=
ZENDESK_REDIRECT_URI=http://127.0.0.1:8787/auth/connectors/zendesk/callback
ZENDESK_WEBHOOK_SECRET=

INTERCOM_CLIENT_ID=
INTERCOM_CLIENT_SECRET=
INTERCOM_REDIRECT_URI=http://127.0.0.1:8787/auth/connectors/intercom/callback
INTERCOM_WEBHOOK_SECRET=

HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=http://127.0.0.1:8787/auth/connectors/hubspot/callback
HUBSPOT_WEBHOOK_SECRET=

SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_REDIRECT_URI=http://127.0.0.1:8787/auth/connectors/salesforce/callback

# Meeting-transcript providers.
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=http://127.0.0.1:8787/auth/connectors/zoom/callback
ZOOM_WEBHOOK_SECRET_TOKEN=
FIREFLIES_WEBHOOK_SECRET=
GRANOLA_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Model routing, embeddings, reranking, and VCR (RESERVED; SDKs exist, wiring incomplete)
# -----------------------------------------------------------------------------

# One of: replay, record, live. Local development should default to replay.
MODEL_ROUTER_MODE=replay
MODEL_VCR_DIR=./packages/model-router/fixtures

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Tenant-designated or self-hosted OpenAI-compatible endpoint.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# Pluggable reranker credentials (RESERVED). Select providers through tenant model policy,
# not by placing a global provider allowlist in this file.
COHERE_API_KEY=
ZEROENTROPY_API_KEY=

# -----------------------------------------------------------------------------
# Billing (RESERVED)
# -----------------------------------------------------------------------------

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SEAT_MONTHLY_ID=
STRIPE_PRICE_CONNECTOR_TIER_ID=
STRIPE_METER_EVENT_NAME=meminios_ai_tokens
STRIPE_PILOT_DAYS=14

# -----------------------------------------------------------------------------
# Signal email delivery (RESERVED; provider-neutral SMTP contract)
# -----------------------------------------------------------------------------

SMTP_URL=
SIGNAL_DIGEST_FROM_EMAIL=
SIGNAL_DIGEST_REPLY_TO_EMAIL=

# -----------------------------------------------------------------------------
# Observability (RESERVED)
# -----------------------------------------------------------------------------

# Server-side Sentry DSN and browser-visible DSN are separate projects/keys.
SENTRY_DSN=
VITE_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT_API=
SENTRY_PROJECT_WEB=
SENTRY_PROJECT_LANDING=

# Standard OpenTelemetry SDK/exporter variables.
OTEL_SERVICE_NAME=meminios-api
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local

# -----------------------------------------------------------------------------
# Cloudflare, Neon, Vercel, and CI deployment (CURRENT workflow + RESERVED IaC)
# -----------------------------------------------------------------------------

CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=

NEON_API_KEY=
NEON_ORG_ID=

VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# Terraform automatically maps TF_VAR_* values to infra/terraform/variables.tf.
TF_VAR_environment=staging
TF_VAR_region=us
TF_VAR_cloudflare_account_id=
TF_VAR_cloudflare_zone_id=
TF_VAR_neon_org_id=
TF_VAR_vercel_team_id=

# -----------------------------------------------------------------------------
# R2/S3 access for container workloads (RESERVED)
# -----------------------------------------------------------------------------

R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=meminios-local

# -----------------------------------------------------------------------------
# Customer-managed KMS / HYOK service identities (RESERVED)
# -----------------------------------------------------------------------------

# Prefer workload identity or short-lived role credentials in production. Do not place a
# customer's tenant-specific KMS grant or key ARN in global environment configuration.
AWS_REGION=
AWS_ROLE_ARN=
AWS_KMS_KEY_ARN=

GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_KMS_KEY_NAME=
GOOGLE_APPLICATION_CREDENTIALS=

# -----------------------------------------------------------------------------
# Product policy defaults (RESERVED)
# -----------------------------------------------------------------------------

DEFAULT_TENANT_REGION=us
DEFAULT_DATA_RETENTION_DAYS=365
AUDIT_RETENTION_DAYS=365
RATE_LIMIT_REQUESTS_PER_MINUTE=120
