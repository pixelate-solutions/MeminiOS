{
  "name": "@meminios/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "clean": "rm -rf dist .wrangler coverage",
    "dev": "wrangler dev --port 8787",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hono/zod-validator": "0.9.0",
    "@meminios/auth": "workspace:*",
    "@meminios/db": "workspace:*",
    "@meminios/retrieval": "workspace:*",
    "@meminios/shared": "workspace:*",
    "hono": "4.12.31",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260721.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wrangler": "4.112.0"
  }
}
